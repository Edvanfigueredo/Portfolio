---
pagination: { data: site.languages, size: 1, alias: lang }
permalink: "{% if lang == 'pt' %}/pt{% endif %}/projects/index.html"
layout: layouts/base.njk
pageKey: projects
---
{%- set P = t[lang].projects -%}
<section class="page-head">
  <div class="container">
    <p class="eyebrow">{{ t[lang].ui.nav.projects }}</p>
    <h1>{{ P.title }}</h1>
    <p class="lead">{{ P.intro }}</p>
  </div>
</section>

<section class="section" aria-labelledby="list-title">
  <div class="container">
    <h2 id="list-title" class="visually-hidden">{{ P.listTitle }}</h2>
    <div class="grid grid-2">
      {%- for key in ["pulse", "guibbor", "capstone", "fma"] %}
      {% include "partials/project-card.njk" %}
      {%- endfor %}
    </div>
    <h2 class="h-sm mt-6">{{ P.otherTitle }}</h2>
    <ul class="other-list">
      {%- for o in P.others %}
      <li class="other-item">
        <div class="other-head">
          <h3>{{ o.name }}</h3>
          <span class="badge badge-type-learning">{{ o.typeText }}</span>
        </div>
        <p>{{ o.text }}</p>
        <div class="other-foot">
          <ul class="stack" aria-label="{{ t[lang].ui.stack }}">{% for st in o.stack %}<li>{{ st }}</li>{% endfor %}</ul>
          <a href="{{ o.repo }}" rel="noopener noreferrer" target="_blank">{{ t[lang].ui.viewRepo }}<span class="visually-hidden"> — {{ o.name }} {{ t[lang].ui.newTab }}</span></a>
        </div>
      </li>
      {%- endfor %}
    </ul>
    <h2 class="h-xs mt-6">{{ P.typesTitle }}</h2>
    <ul class="legend">
      {%- for ty in P.types %}
      <li><span class="badge badge-type-{{ ty.key }}">{{ ty.label }}</span><span>{{ ty.text }}</span></li>
      {%- endfor %}
    </ul>
    <div class="note"><p>{{ P.hiddenNote }}</p></div>
  </div>
</section>
