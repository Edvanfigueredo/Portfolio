---
pagination: { data: site.languages, size: 1, alias: lang }
permalink: "{% if lang == 'pt' %}/pt{% endif %}/contact/index.html"
layout: layouts/base.njk
pageKey: contact
---
{%- set C = t[lang].contact -%}
<section class="page-head">
  <div class="container prose">
    <p class="eyebrow">{{ t[lang].ui.nav.contact }}</p>
    <h1>{{ C.title }}</h1>
    <p class="lead">{{ C.text }}</p>
  </div>
</section>

<section class="section" aria-label="{{ C.title }}">
  <div class="container prose">
    {%- set socialVariant = "buttons" %}
    {% include "partials/social-links.njk" %}
    <p class="contact-email"><span class="label">{{ C.email }}</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <p class="muted">{{ C.note }}</p>
  </div>
</section>
