---
pagination: { data: site.languages, size: 1, alias: lang }
permalink: "{% if lang == 'pt' %}/pt{% endif %}/contact/index.html"
layout: layouts/base.njk
pageKey: contact
---
{%- set C = t[lang].contact -%}
<section class="page-head">
  <div class="container prose">
    <p class="eyebrow">{{ t[lang].ui.nav.contact }}</p>
    <h1>{{ C.title }}</h1>
    <p class="lead">{{ C.text }}</p>
  </div>
</section>

<section class="section" aria-label="{{ C.title }}">
  <div class="container prose">
    <ul class="contact-list">
      <li><span class="label">{{ C.email }}</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      <li><span class="label">{{ C.linkedin }}</span><a href="{{ site.linkedin }}" rel="noopener noreferrer" target="_blank">linkedin.com/in/edvan-figuerêdo-araujo-7b8332272<span class="visually-hidden"> {{ t[lang].ui.newTab }}</span></a></li>
      <li><span class="label">{{ C.github }}</span><a href="{{ site.github }}" rel="noopener noreferrer" target="_blank">github.com/Edvanfigueredo<span class="visually-hidden"> {{ t[lang].ui.newTab }}</span></a></li>
    </ul>
    <p class="muted">{{ C.note }}</p>
  </div>
</section>
