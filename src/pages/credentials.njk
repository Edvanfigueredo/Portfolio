---
pagination: { data: site.languages, size: 1, alias: lang }
permalink: "{% if lang == 'pt' %}/pt{% endif %}/credentials/index.html"
layout: layouts/base.njk
pageKey: credentials
---
{%- set C = t[lang].credentials -%}
<section class="page-head">
  <div class="container">
    <p class="eyebrow">{{ t[lang].ui.nav.credentials }}</p>
    <h1>{{ C.title }}</h1>
    <p class="lead">{{ C.intro }}</p>
  </div>
</section>

<section class="section" aria-labelledby="ms-title">
  <div class="container">
    <h2 id="ms-title" class="h-sm">{{ C.msTitle }}</h2>
    <div class="grid grid-3">
      {%- for c in C.ms %}
      <article class="card">
        <span class="badge badge-certified card-tag">{{ c.code }}</span>
        <h3>{{ c.name }}</h3>
        <p class="mono muted">{{ c.date }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="uni-title">
  <div class="container">
    <div class="section-head"><h2 id="uni-title" class="h-sm">{{ C.uniTitle }}</h2><p>{{ C.uniNote }}</p></div>
    <ul class="entries">
      {%- for u in C.uni %}
      <li class="entry"><p class="entry-period">{{ u.org }}</p><div><p class="entry-role mt-0">{{ u.items }}</p></div></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container grid grid-2">
    <div><h2 class="h-sm">{{ C.eyTitle }}</h2><p class="muted">{{ C.ey }}</p></div>
    <div><h2 class="h-sm">{{ C.moreTitle }}</h2><p class="muted">{{ C.more }}</p></div>
  </div>
</section>
